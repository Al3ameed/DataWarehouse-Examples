      <button class="node dw rise" data-node="dw" style="--c:var(--blue);--t:var(--tint-blue);--rr:5deg"><span class="ic">🏢</span><span class="node-title">Data Warehouse</span><span class="node-sub">البيت الكبير لداتا الشركة كلها</span></button>
