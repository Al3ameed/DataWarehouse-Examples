/* ---------- SQL typewriter ---------- */
function buildSQL(){
  const d=path.length,gc=d<4?'b.'+GEO_COLS[d]:'d.month';
  const L=[['SELECT '+gc+', SUM(f.sales) AS total_sales'],['FROM fact_sales f'],['JOIN dim_branch b ON f.branch_key = b.branch_key'],['JOIN dim_date d ON f.date_key = d.date_key'],['WHERE d.year = 2025']];
  path.forEach((n,i)=>L.push(['  AND b.'+GEO_COLS[i]+" = '"+n.name+"'",i===d-1?'fresh':'cond']));
  L.push(['GROUP BY '+gc+';']);
  const kw=s=>esc(s).replace(/\b(SELECT|SUM|AS|FROM|JOIN|ON|WHERE|AND|GROUP BY)\b/g,'<span class="kw">$1</span>');
  return {plain:L.map(l=>l[0]).join('\n'),html:L.map(l=>l[1]?'<span class="'+l[1]+'">'+kw(l[0])+'</span>':kw(l[0])).join('\n')};
}
let typeTok=0;
function typeSQL(){
  const tok=++typeTok,q=buildSQL(),el=$('#sql');
  if(RM){el.innerHTML=q.html;return;}
  let i=0;const n=q.plain.length,stepN=Math.ceil(n/45);
  const step=()=>{
    if(tok!==typeTok) return;
    i=Math.min(n,i+stepN);
    if(i<n){el.textContent=q.plain.slice(0,i);el.insertAdjacentHTML('beforeend','<span class="caret"></span>');requestAnimationFrame(step);}
    else el.innerHTML=q.html;
  };
  step();
}

