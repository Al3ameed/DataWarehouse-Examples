<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>الداتا ليها بيت: Drill Down و Data Mart و Data Mining</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Alexandria:wght@500;700;800;900&family=Rubik:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
/* ===== Palette: "Deep Orbit" =====
   Void #07060D · Nebula panel #110E1F · Starlight #EEEAFB
   Violet thrust #9B7BFF · Deep orbit #6A4BF0 · Ion blue #7D96FF
   Aurora #3FE0D0 · Supernova #F062C0 · Rocket flame #FF9F5A            */
:root{
  --bg:#F6F4FB;--panel:#FFFFFF;--glass:rgba(255,255,255,.8);--ink:#14102A;--muted:#5D5878;--line:#E3DFF0;
  --blue:#4A64E8;--sun:#6C4BE3;--violet:#4B2FBF;--mint:#0C9C90;--pink:#C23A99;--flame:#D9732C;--on-sun:#FFFFFF;--on-acc:#FFFFFF;
  --tint-blue:#ECEFFF;--tint-sun:#F0EBFF;--tint-mint:#E0F5F2;--tint-pink:#FBE8F5;--tint-flame:#FDEFE4;
  --good:#0E9C69;--bad:#D93A55;--tint-good:#DCF6EB;--tint-bad:#FCE4E8;
  --shadow:0 18px 50px -20px rgba(75,47,191,.35);--blob-op:.16;--star:rgba(108,75,227,.32);
  --code-bg:#120E24;--code-ink:#E9E4FF;
  color-scheme:light;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --bg:#07060D;--panel:#110E1F;--glass:rgba(22,18,40,.62);--ink:#EEEAFB;--muted:#9C96B8;--line:#262040;
    --blue:#7D96FF;--sun:#9B7BFF;--violet:#6A4BF0;--mint:#3FE0D0;--pink:#F062C0;--flame:#FF9F5A;--on-sun:#FFFFFF;--on-acc:#0B0918;
    --tint-blue:#151B3A;--tint-sun:#1B1537;--tint-mint:#0E2928;--tint-pink:#2A1130;--tint-flame:#2C1B10;
    --good:#3DDC97;--bad:#FF6B81;--tint-good:#0E2A21;--tint-bad:#311521;
    --shadow:0 20px 60px -20px rgba(106,75,240,.55);--blob-op:.22;--star:rgba(255,255,255,.75);
    --code-bg:#05040B;--code-ink:#E9E4FF;
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#07060D;--panel:#110E1F;--glass:rgba(22,18,40,.62);--ink:#EEEAFB;--muted:#9C96B8;--line:#262040;
  --blue:#7D96FF;--sun:#9B7BFF;--violet:#6A4BF0;--mint:#3FE0D0;--pink:#F062C0;--flame:#FF9F5A;--on-sun:#FFFFFF;--on-acc:#0B0918;
  --tint-blue:#151B3A;--tint-sun:#1B1537;--tint-mint:#0E2928;--tint-pink:#2A1130;--tint-flame:#2C1B10;
  --good:#3DDC97;--bad:#FF6B81;--tint-good:#0E2A21;--tint-bad:#311521;
  --shadow:0 20px 60px -20px rgba(106,75,240,.55);--blob-op:.22;--star:rgba(255,255,255,.75);
  --code-bg:#05040B;--code-ink:#E9E4FF;
  color-scheme:dark;
}
*,*::before,*::after{box-sizing:inherit}
[hidden]{display:none!important}
html{scroll-padding-top:env(safe-area-inset-top,0px);-webkit-text-size-adjust:100%}
html,body{margin:0}
body{background:var(--bg);color:var(--ink);font-family:"Rubik",Tahoma,"Segoe UI",Arial,sans-serif;font-size:17px;line-height:1.75;overflow-x:hidden;padding-bottom:118px}
button{font:inherit;color:inherit}
p{margin:0}
:focus-visible{outline:2px solid var(--sun);outline-offset:3px}
h1,h2,h3{font-family:"Alexandria","Rubik",Tahoma,sans-serif;margin:0;line-height:1.2}

/* ---------- space background ---------- */
.space{position:fixed;inset:0;z-index:-1;overflow:hidden;pointer-events:none}
.stars-a,.stars-b{position:absolute;left:0;right:0;top:-400px;bottom:0;background-repeat:repeat}
.stars-a{background-image:radial-gradient(1.4px 1.4px at 23px 41px,var(--star) 50%,transparent 52%),radial-gradient(1px 1px at 141px 97px,var(--star) 50%,transparent 52%),radial-gradient(1.2px 1.2px at 263px 211px,var(--star) 50%,transparent 52%),radial-gradient(1px 1px at 77px 301px,var(--star) 50%,transparent 52%),radial-gradient(1.6px 1.6px at 331px 33px,var(--star) 50%,transparent 52%);background-size:400px 400px;animation:starDrift 140s linear infinite;opacity:.8}
.stars-b{background-image:radial-gradient(1px 1px at 61px 129px,var(--star) 50%,transparent 52%),radial-gradient(1.3px 1.3px at 191px 23px,var(--star) 50%,transparent 52%),radial-gradient(1px 1px at 233px 167px,var(--star) 50%,transparent 52%);background-size:260px 260px;animation:starDrift 90s linear infinite;opacity:.5}
@keyframes starDrift{to{transform:translateY(400px)}}
.blob{position:absolute;width:52vmax;height:52vmax;border-radius:50%;filter:blur(90px);opacity:var(--blob-op);animation:drift 26s ease-in-out infinite alternate}
.b1{background:#6A4BF0;top:-18vmax;right:-14vmax}
.b2{background:#C23A99;top:40vh;left:-22vmax;animation-duration:30s}
.b3{background:#3B4BD6;bottom:-26vmax;right:18vw;animation-duration:34s}
@keyframes drift{to{transform:translate(8vmax,6vmax) scale(1.15)}}

/* ---------- buttons ---------- */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:12px 22px;border-radius:999px;border:1px solid var(--line);background:var(--glass);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);font-weight:600;cursor:pointer;transition:transform .25s cubic-bezier(.3,1.5,.5,1),box-shadow .25s,border-color .25s}
.btn:hover:not(:disabled){transform:translateY(-2px);border-color:var(--sun);box-shadow:0 10px 28px -12px var(--sun)}
.btn:active:not(:disabled){transform:scale(.97)}
.btn.sun{background:linear-gradient(135deg,var(--sun),var(--violet));color:#fff;border-color:transparent;box-shadow:0 10px 30px -12px var(--violet)}
.btn.sun:hover:not(:disabled){box-shadow:0 14px 36px -10px var(--sun);border-color:transparent}
.btn.small{padding:8px 16px;font-size:.92rem}
.btn:disabled{opacity:.38;cursor:not-allowed}
.pills{display:flex;flex-wrap:wrap;gap:10px}
.pill{padding:9px 18px;border-radius:999px;border:1px solid var(--line);background:var(--glass);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);cursor:pointer;font-weight:500;transition:transform .25s cubic-bezier(.3,1.5,.5,1),background-color .25s,border-color .25s,box-shadow .25s}
.pill:hover{transform:translateY(-2px);border-color:var(--c,var(--sun))}
.pill[aria-pressed="true"]{background:var(--t,var(--tint-sun));border-color:var(--c,var(--sun));font-weight:700;box-shadow:0 0 0 1px var(--c,var(--sun)),0 10px 26px -14px var(--c,var(--sun))}

/* ---------- hero ---------- */
.hero{position:relative;overflow:hidden;min-height:min(90vh,820px);display:flex;align-items:center}
.fall-layer{position:absolute;inset:0;pointer-events:none;overflow:hidden}
.fall{position:absolute;top:-60px;font-size:var(--s);color:var(--fc);opacity:.55;text-shadow:0 0 12px var(--fc);animation:fall var(--d) linear infinite;animation-delay:var(--dl)}
@keyframes fall{from{transform:translateY(0) rotate(0)}to{transform:translateY(calc(100vh + 140px)) rotate(var(--rot))}}
.shoot{position:absolute;width:140px;height:2px;border-radius:2px;background:linear-gradient(90deg,var(--sun),transparent);opacity:0;transform:rotate(-32deg);animation:shoot var(--d) ease-in infinite;animation-delay:var(--dl)}
@keyframes shoot{0%{opacity:0;translate:0 0}8%{opacity:.9}30%{opacity:0;translate:-55vw 34vw}100%{opacity:0;translate:-55vw 34vw}}
.hero-grid{position:relative;z-index:1;width:100%;max-width:1180px;margin:0 auto;padding:60px 22px 40px;display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);gap:28px;align-items:center}
h1{font-weight:900;font-size:clamp(3.2rem,11vw,7.4rem);line-height:1.05;letter-spacing:-.01em}
h1 .w{display:inline-block;background:linear-gradient(180deg,var(--ink) 35%,var(--sun) 135%);-webkit-background-clip:text;background-clip:text;color:transparent;animation:wordDrop 1.1s cubic-bezier(.2,1.4,.4,1) backwards;animation-delay:calc(var(--i)*130ms + 120ms)}
h1 .w.em{background:none;color:initial}
@keyframes wordDrop{0%{transform:translateY(-140%) rotate(var(--r,-14deg));opacity:0}55%{opacity:1}100%{transform:none;opacity:1}}
.sub{font-size:clamp(1.05rem,2.3vw,1.22rem);color:var(--muted);max-width:50ch;margin:20px 0 28px;animation:fadeUp .9s .7s backwards}
.cta{display:flex;flex-wrap:wrap;gap:12px;animation:fadeUp .9s .9s backwards}
@keyframes fadeUp{from{opacity:0;transform:translateY(20px)}}
.hero-art{position:relative;height:430px}
.orbit{position:absolute;top:50%;left:50%;width:330px;height:330px;margin:-165px 0 0 -165px;border-radius:50%;border:1px dashed var(--line);animation:spin 16s linear infinite}
.orbit .rk{position:absolute;top:-17px;left:50%;margin-left:-15px;font-size:28px;line-height:1;transform:rotate(45deg);filter:drop-shadow(0 0 10px var(--flame))}
.orbit::after{content:"";position:absolute;bottom:-6px;left:50%;margin-left:-6px;width:12px;height:12px;border-radius:50%;background:var(--mint);box-shadow:0 0 14px var(--mint)}
.cube-scene{position:absolute;top:50%;left:50%;width:160px;height:160px;margin:-80px 0 0 -80px;perspective:900px;animation:cubeIn 1.4s .3s cubic-bezier(.2,1.4,.4,1) backwards}
@keyframes cubeIn{from{transform:translateY(-140%) scale(.4);opacity:0}}
.cube{position:relative;width:100%;height:100%;transform-style:preserve-3d;animation:cubeSpin 20s linear infinite}
@keyframes cubeSpin{from{transform:rotateX(-22deg) rotateY(0)}to{transform:rotateX(338deg) rotateY(360deg)}}
.face{position:absolute;inset:0;display:grid;place-items:center;font:800 1.3rem/1 "Alexandria",sans-serif;letter-spacing:.04em;color:#EEEAFB;border-radius:20px;border:1px solid var(--fc);background:linear-gradient(150deg,var(--fc) -70%,#0C0A1A 65%);box-shadow:inset 0 0 34px -6px var(--fc),0 0 30px -10px var(--fc);direction:ltr}
.f1{--fc:#9B7BFF;transform:translateZ(80px)}
.f2{--fc:#7D96FF;transform:rotateY(90deg) translateZ(80px)}
.f3{--fc:#3FE0D0;transform:rotateY(180deg) translateZ(80px)}
.f4{--fc:#F062C0;transform:rotateY(-90deg) translateZ(80px)}
.f5{--fc:#6A4BF0;transform:rotateX(90deg) translateZ(80px)}
.f6{--fc:#FF9F5A;transform:rotateX(-90deg) translateZ(80px)}
.badge{position:absolute;top:0;right:2%;width:130px;height:130px;animation:spin 18s linear infinite reverse}
.badge text{font:600 12px "Alexandria",sans-serif;fill:var(--muted);direction:ltr;letter-spacing:.5px}
@keyframes spin{to{transform:rotate(360deg)}}
.sticker{position:absolute;display:inline-flex;align-items:center;gap:8px;padding:7px 14px;border-radius:999px;font:700 .9rem "Alexandria",sans-serif;color:var(--ink);background:var(--glass);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border:1px solid var(--line);box-shadow:0 12px 30px -14px var(--sc);animation:bob 5s ease-in-out infinite;white-space:nowrap}
.sticker::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--sc);box-shadow:0 0 10px var(--sc)}
.s1{--sc:var(--pink);top:68%;left:0;rotate:-5deg;direction:ltr}
.s2{--sc:var(--mint);top:8%;left:4%;rotate:4deg;animation-delay:-1.6s}
.s3{--sc:var(--sun);bottom:2%;right:10%;rotate:-3deg;animation-delay:-3.2s}
@keyframes bob{50%{transform:translateY(-14px)}}
@media (max-width:860px){
  .hero{min-height:auto}
  .hero-grid{grid-template-columns:1fr;padding-top:34px}
  .hero-art{order:-1;height:260px}
  .cube-scene,.orbit{scale:.72}
}

/* ---------- marquee ---------- */
.marquees{position:relative;height:130px;overflow:hidden;margin:0 0 6px}
.mq{position:absolute;left:-6%;right:-6%;direction:ltr;white-space:nowrap;font:800 1.2rem "Alexandria",sans-serif;letter-spacing:.06em;padding:11px 0}
.mq1{top:30px;background:linear-gradient(90deg,#4B2FBF,#9B7BFF 45%,#F062C0);color:#fff;transform:rotate(-2.4deg);z-index:2;box-shadow:0 14px 40px -16px #6A4BF0}
.mq2{top:50px;background:var(--panel);color:var(--muted);border-block:1px solid var(--line);transform:rotate(2deg)}
.mq .track{display:inline-block;animation:mq 34s linear infinite}
.mq2 .track{animation-direction:reverse}
@keyframes mq{to{transform:translateX(-50%)}}

/* ---------- layout ---------- */
main{max-width:1180px;margin:0 auto;padding:6px 22px 40px}
.view h2{font-weight:900;font-size:clamp(2rem,5.4vw,3.2rem);margin-top:18px}
.lead{max-width:64ch;color:var(--muted);font-size:1.08rem;margin:12px 0 26px}
.glass{background:var(--glass);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border:1px solid var(--line);border-radius:24px;padding:22px;box-shadow:inset 0 1px 0 rgba(255,255,255,.05)}
.muted{color:var(--muted)}
.small{font-size:.9rem}
.view.play .rise{animation:rise .95s cubic-bezier(.2,1.3,.4,1) backwards;animation-delay:calc(var(--i,0)*90ms)}
@keyframes rise{from{opacity:0;transform:translateY(-60px) rotate(var(--rr,-4deg)) scale(.94)}to{opacity:1;transform:none}}
.empty{border:1px dashed var(--line);border-radius:18px;padding:22px;color:var(--muted);text-align:center}

/* ---------- dock ---------- */
.dock-wrap{position:fixed;bottom:0;left:0;right:0;z-index:40;display:flex;justify-content:center;padding:0 10px calc(12px + env(safe-area-inset-bottom,0px));pointer-events:none}
.dock{pointer-events:auto;position:relative;display:flex;padding:6px;border-radius:999px;background:var(--glass);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border:1px solid var(--line);box-shadow:var(--shadow)}
.dock-ind{position:absolute;left:0;top:6px;bottom:6px;width:0;border-radius:999px;background:linear-gradient(135deg,var(--sun),var(--violet));box-shadow:0 6px 20px -6px var(--sun);transition:transform .55s cubic-bezier(.3,1.35,.5,1),width .55s cubic-bezier(.3,1.35,.5,1)}
.dock-btn{position:relative;z-index:1;display:flex;flex-direction:column;align-items:center;padding:5px 14px;min-width:66px;border:none;background:none;border-radius:999px;cursor:pointer;font-size:.76rem;font-weight:600;line-height:1.3;color:var(--muted);transition:color .35s}
.dock-btn .ic{font-size:1.25rem;line-height:1.25;transition:transform .45s cubic-bezier(.3,1.6,.5,1)}
.dock-btn[aria-selected="true"]{color:#fff}
.dock-btn[aria-selected="true"] .ic{transform:translateY(-2px) rotate(-10deg) scale(1.15)}
@media (max-width:440px){.dock-btn{min-width:0;padding:5px 9px;font-size:.66rem}}

/* ---------- overview ---------- */
.pipeline{display:flex;align-items:center}
.node{flex:1 1 0;min-width:0;display:flex;flex-direction:column;align-items:flex-start;gap:2px;text-align:start;padding:16px 14px;border-radius:20px;border:1px solid var(--line);border-top:3px solid var(--c);background:var(--glass);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);cursor:pointer;transition:transform .3s cubic-bezier(.3,1.5,.5,1),box-shadow .3s,background-color .3s,border-color .3s}
.node:hover{transform:translateY(-4px);box-shadow:0 16px 36px -16px var(--c)}
.node[aria-pressed="true"]{background:var(--t);border-color:var(--c);box-shadow:0 0 0 1px var(--c),0 20px 44px -18px var(--c);transform:translateY(-4px)}
.node .ic{font-size:1.8rem;line-height:1.2;display:inline-block}
.node[aria-pressed="true"] .ic{animation:wiggle .7s}
@keyframes wiggle{25%{transform:rotate(-16deg) scale(1.18)}55%{transform:rotate(12deg) scale(1.12)}80%{transform:rotate(-5deg)}}
.node-title{font-family:"Alexandria",sans-serif;font-weight:700;font-size:1.04rem;line-height:1.3}
.node-sub{font-size:.82rem;color:var(--muted);line-height:1.45}
.node.dw{flex-grow:1.3;justify-content:center}
.node.dw .node-title{font-size:1.28rem}
.pipe{flex:0 0 40px;align-self:center;height:3px;border-radius:2px;background:repeating-linear-gradient(90deg,var(--c,var(--blue)) 0 8px,transparent 8px 16px);background-size:32px 100%;animation:flowL .7s linear infinite;box-shadow:0 0 10px var(--c)}
@keyframes flowL{from{background-position:0 0}to{background-position:-32px 0}}
.stack{flex:1.1 1 0;min-width:0;display:flex;flex-direction:column;gap:10px}
.stack .node{flex-direction:row;align-items:center;gap:10px;padding:10px 12px}
.stack .node .ic{font-size:1.45rem}
@media (max-width:900px){
  .pipeline{flex-direction:column;align-items:stretch}
  .pipe{flex-basis:34px;width:3px;height:34px;background:repeating-linear-gradient(180deg,var(--c,var(--blue)) 0 8px,transparent 8px 16px);background-size:100% 32px;animation-name:flowD}
}
@keyframes flowD{from{background-position:0 0}to{background-position:0 32px}}
.node-info{margin-top:24px;border-inline-start:4px solid var(--c)}
.node-info p{max-width:70ch;margin:8px 0 16px}
.node-info h3{font-size:1.45rem;font-weight:800}
.pop{animation:popIn .55s cubic-bezier(.3,1.5,.5,1)}
@keyframes popIn{from{transform:scale(.95);opacity:.4}}

/* ---------- drill map ---------- */
.drill-layout{display:grid;grid-template-columns:minmax(0,1fr) 350px;gap:18px;align-items:start}
@media (max-width:980px){.drill-layout{grid-template-columns:1fr}}
.map-shell{position:relative;height:clamp(460px,74vh,760px);border-radius:28px;overflow:hidden;background:radial-gradient(ellipse at 50% 26%,#1A1342 0%,#08061A 55%,#030209 100%);border:1px solid rgba(155,123,255,.35);box-shadow:0 0 0 1px rgba(155,123,255,.08),0 40px 90px -40px rgba(106,75,240,.75);user-select:none;-webkit-user-select:none}
@media (max-width:600px){.map-shell{height:clamp(400px,64vh,580px);border-radius:22px}}
#stars{position:absolute;inset:0;width:100%;height:100%;animation:twinkle 3.5s ease-in-out infinite alternate}
@keyframes twinkle{to{opacity:.55}}
.tilt{position:absolute;inset:0;transform-origin:50% 64%;transition:transform 1.9s cubic-bezier(.45,.05,.2,1)}
#map{display:block;width:100%;height:100%;touch-action:pan-y}
.sphere{fill:url(#ocean)}
.atmo{fill:url(#atmo);pointer-events:none}
.grat{fill:none;stroke:rgba(155,123,255,.22);stroke-width:.6;pointer-events:none}
.country{fill:#17132D;stroke:#2C2654;stroke-width:.5;cursor:pointer;transition:fill .3s}
.country:hover{fill:#201A3D}
.land{fill:#3A2F6E;stroke:none;pointer-events:none}
.gov{stroke:rgba(200,185,255,.28);stroke-width:.7;stroke-linejoin:round;transition:fill .7s,fill-opacity .7s}
.gov.hit{cursor:pointer}
.gov.hit:hover,.gov.hl{stroke:#fff;stroke-width:2.2}
.water{pointer-events:none}
.nile-glow{fill:none;stroke:#6FD3FF;stroke-opacity:.35;filter:url(#blur)}
.nile{fill:none;stroke:#8EDFFF;stroke-linecap:round;stroke-linejoin:round}
.lake{fill:#3446D0;stroke:#6F84FF;stroke-width:.6}
.fine{fill:none;stroke:rgba(155,123,255,.26);stroke-width:1;pointer-events:none}
.glow{fill:url(#glowg);pointer-events:none}
.ov{position:absolute;inset:0;z-index:2;pointer-events:none;overflow:hidden}
.hlbl{position:absolute;left:0;top:0;text-align:center;color:#fff;font:700 15px/1.25 "Alexandria",sans-serif;white-space:nowrap;text-shadow:0 1px 0 #05040F,0 0 6px rgba(5,4,15,.95),0 0 16px rgba(5,4,15,.8);transition:opacity .5s}
.hlbl span{display:block;font-size:12px;font-weight:500;color:#C9B8FF}
.hlbl.off{opacity:0}
.hegm{position:absolute;left:0;top:0;width:0;height:0;padding:0;border:none;background:none;pointer-events:auto;cursor:pointer}
.hegm.off{display:none}
.hegm .dot{position:absolute;left:-9px;top:-9px;width:18px;height:18px;border-radius:50%;background:#9B7BFF;border:2px solid #fff;box-shadow:0 0 16px #9B7BFF}
.hegm .ring{position:absolute;left:-15px;top:-15px;width:30px;height:30px;border-radius:50%;border:2px solid #C9B8FF;animation:pulse 1.6s ease-out infinite}
.hpin{position:absolute;left:0;top:0;width:0;height:0;padding:0;border:none;background:none;pointer-events:auto;cursor:pointer}
.hpin.off{display:none}
.hpin-in{position:absolute;left:-17px;bottom:0;width:34px;height:48px;display:block}
.hpin.show .hpin-in{animation:pinDrop 1s ease-out backwards;animation-delay:var(--pd,0ms)}
.hpin svg{display:block;overflow:visible;filter:drop-shadow(0 0 8px rgba(255,159,90,.55)) drop-shadow(0 6px 5px rgba(0,0,0,.5))}
.hpin .body{fill:#FF9F5A;stroke:#0B0918;stroke-width:1.6;transition:fill .25s}
.hpin .eye{fill:#0B0918}
.hpin .pulse{position:absolute;left:50%;bottom:-9px;width:20px;height:20px;margin-left:-10px;border-radius:50%;border:1.5px solid #FF9F5A;background:rgba(255,159,90,.2);animation:pulse 1.8s ease-out infinite}
.hpin:hover .body,.hpin.hl .body{fill:#fff}
.hpin.sel .body{fill:#F062C0}
.hpin.sel svg{filter:drop-shadow(0 0 10px rgba(240,98,192,.7)) drop-shadow(0 6px 5px rgba(0,0,0,.5))}
.hpin.sel .pulse{border-color:#F062C0;background:rgba(240,98,192,.25)}
.hpin-t{position:absolute;bottom:52px;left:50%;transform:translateX(-50%);color:#fff;font:700 13px "Alexandria",sans-serif;white-space:nowrap;text-shadow:0 1px 0 #05040F,0 0 6px rgba(5,4,15,.95)}
@keyframes pinDrop{0%{transform:translateY(-160px);opacity:0}50%{transform:translateY(0);opacity:1}68%{transform:translateY(-20px)}82%{transform:translateY(0)}92%{transform:translateY(-6px)}100%{transform:translateY(0)}}
@keyframes pulse{from{transform:scale(.5);opacity:.95}to{transform:scale(2.8);opacity:0}}
.mo{position:absolute;z-index:3}
.map-top{top:12px;left:12px;right:12px;display:flex;justify-content:space-between;align-items:flex-start;gap:8px;pointer-events:none}
.mcrumbs{display:flex;flex-wrap:wrap;gap:6px;pointer-events:auto}
.mcrumb{background:rgba(20,16,40,.55);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);color:#E6E0FF;border:1px solid rgba(155,123,255,.3);border-radius:999px;padding:4px 12px;font-size:.84rem;font-weight:500;cursor:pointer;animation:crumbIn .5s cubic-bezier(.3,1.5,.5,1) backwards}
.mcrumb:hover{border-color:#9B7BFF;background:rgba(40,30,80,.6)}
.mcrumb.cur{background:linear-gradient(135deg,#9B7BFF,#6A4BF0);color:#fff;border-color:transparent;cursor:default;box-shadow:0 6px 18px -6px #9B7BFF}
@keyframes crumbIn{from{transform:translateY(-14px) scale(.85);opacity:0}}
.alt{flex:none;background:rgba(20,16,40,.6);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);color:#B9AFDF;border:1px solid rgba(155,123,255,.3);border-radius:14px;padding:4px 12px;font-size:.78rem;line-height:1.4;text-align:center}
.alt b{display:block;font:700 1rem "Alexandria",sans-serif;color:#fff;direction:ltr;font-variant-numeric:tabular-nums}
.map-bottom{bottom:12px;left:12px;right:12px;display:flex;justify-content:space-between;align-items:flex-end;gap:10px;pointer-events:none}
.mhint{pointer-events:none;background:rgba(20,16,40,.62);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);color:#fff;border:1px solid rgba(155,123,255,.3);border-radius:16px;padding:7px 14px;font-size:.88rem;font-weight:500;max-width:70%}
.mhint.bump{animation:bump .6s cubic-bezier(.3,1.6,.5,1)}
@keyframes bump{from{transform:scale(.85)}}
.mctl{display:flex;flex-direction:column;gap:8px;pointer-events:auto}
.mbtn{width:44px;height:44px;border-radius:50%;border:1px solid rgba(155,123,255,.4);background:rgba(20,16,40,.7);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);color:#fff;font-size:1.15rem;font-weight:700;cursor:pointer;transition:transform .2s cubic-bezier(.3,1.5,.5,1),box-shadow .2s,border-color .2s}
.mbtn:hover:not(:disabled){transform:translateY(-2px);border-color:#9B7BFF;box-shadow:0 0 20px -4px #9B7BFF}
.mbtn:disabled{opacity:.35;cursor:not-allowed}
.eg-bubble{position:absolute;z-index:3;transform:translate(-50%,calc(-100% - 26px));background:linear-gradient(135deg,#9B7BFF,#6A4BF0);color:#fff;border-radius:14px;padding:5px 12px;font:700 .88rem "Alexandria",sans-serif;white-space:nowrap;box-shadow:0 10px 26px -8px #9B7BFF;pointer-events:none;animation:floaty 2s ease-in-out infinite}
.eg-bubble::after{content:"";position:absolute;bottom:-7px;left:50%;margin-left:-7px;border:7px solid transparent;border-top-color:#7D5DF5;border-bottom:0}
@keyframes floaty{50%{margin-top:-8px}}
.mtip{position:absolute;z-index:4;pointer-events:none;transform:translate(-50%,calc(-100% - 14px));background:rgba(12,10,26,.92);color:#fff;border:1px solid rgba(155,123,255,.35);border-radius:12px;padding:6px 12px;font-size:.85rem;line-height:1.45;white-space:nowrap;text-align:center}
.mtip b{font-family:"Alexandria",sans-serif}
.mtoast{top:56px;left:50%;transform:translateX(-50%);background:rgba(20,16,40,.85);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);color:#fff;border:1px solid #F062C0;border-radius:14px;padding:6px 14px;font-weight:500;font-size:.9rem;box-shadow:0 10px 30px -10px #F062C0;white-space:nowrap;animation:toast 2.4s both;pointer-events:none}
@keyframes toast{0%{opacity:0;transform:translate(-50%,-16px)}12%,80%{opacity:1;transform:translate(-50%,0)}100%{opacity:0;transform:translate(-50%,-10px)}}
.map-fallback{position:absolute;inset:0;display:grid;place-items:center;color:#fff;text-align:center;padding:24px;z-index:5}

.dpanel h3{font-size:1.85rem;font-weight:800;margin-top:6px}
.lvl-tag{display:inline-flex;align-items:center;gap:8px;font-size:.84rem;font-weight:600;background:var(--tint-sun);border:1px solid var(--sun);color:var(--ink);border-radius:999px;padding:3px 12px}
.lvl-tag::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--sun);box-shadow:0 0 8px var(--sun);animation:blink 1.2s infinite}
@keyframes blink{50%{opacity:.25}}
.big{font:800 clamp(2rem,4vw,2.5rem)/1.2 "Alexandria",sans-serif;margin-top:6px;background:linear-gradient(90deg,var(--ink),var(--sun));-webkit-background-clip:text;background-clip:text;color:transparent}
.big small{display:block;font-size:.9rem;font-weight:600;color:var(--muted);-webkit-text-fill-color:var(--muted)}
.steps{display:flex;flex-wrap:wrap;align-items:center;gap:6px;margin:14px 0 4px}
.step{font-size:.78rem;font-weight:600;padding:3px 10px;border-radius:999px;border:1px dashed var(--line);color:var(--muted)}
.step.done{border-style:solid;border-color:var(--sun);color:var(--ink)}
.step.cur{background:linear-gradient(135deg,var(--sun),var(--violet));border:1px solid transparent;color:#fff;box-shadow:0 6px 16px -6px var(--sun)}
.kids{display:flex;flex-direction:column;gap:6px;margin-top:14px}
.krow{display:grid;grid-template-columns:minmax(80px,138px) minmax(0,1fr) 74px;gap:10px;align-items:center;padding:7px 10px;border-radius:14px;border:1px solid transparent;background:transparent;text-align:start;cursor:pointer;transition:background-color .2s,border-color .2s,transform .2s;animation:krowIn .6s cubic-bezier(.3,1.4,.5,1) backwards;animation-delay:calc(var(--i)*70ms)}
.krow:hover{background:var(--panel);border-color:var(--line);transform:translateX(-3px)}
@keyframes krowIn{from{opacity:0;transform:translateX(-30px)}}
.kname{font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.kbar{height:10px;background:var(--line);border-radius:5px;overflow:hidden}
.kbar span{display:block;height:100%;width:0;background:var(--kc);border-radius:5px;box-shadow:0 0 12px var(--kc);transition:width .9s cubic-bezier(.3,1.2,.4,1)}
.kval{font-weight:600;font-size:.88rem;text-align:end;font-variant-numeric:tabular-nums}
.months{display:flex;align-items:flex-end;gap:4px;height:140px;margin-top:16px;padding-bottom:20px;position:relative}
.mbar{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;height:100%;position:relative}
.mbar i{display:block;width:100%;border-radius:6px 6px 2px 2px;background:linear-gradient(180deg,var(--pink),var(--violet));transform-origin:bottom;animation:grow .8s cubic-bezier(.3,1.3,.5,1) backwards;animation-delay:calc(var(--i)*55ms)}
.mbar span{position:absolute;bottom:-20px;font-size:.62rem;color:var(--muted)}
@keyframes grow{from{transform:scaleY(0)}}
.dactions{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px}
.check{margin-top:14px;padding:10px 14px;border-radius:14px;background:var(--tint-mint);border:1px solid var(--mint);font-size:.92rem}
.explain{margin-top:12px}
.sqlbox{margin-top:20px}
.sqlbox h3{font-size:1.22rem;font-weight:700}
.sqlbox > p{margin-top:6px}
pre.sql{direction:ltr;text-align:left;background:var(--code-bg);color:var(--code-ink);padding:16px 18px;border-radius:16px;overflow-x:auto;font-family:ui-monospace,"SFMono-Regular",Menlo,Consolas,monospace;font-size:.88rem;line-height:1.7;margin:12px 0 0;min-height:13em;border:1px solid rgba(155,123,255,.3);box-shadow:inset 0 0 40px -20px rgba(155,123,255,.5)}
pre.sql .kw{color:#B9A4FF;font-weight:700}
pre.sql .cond{background:rgba(155,123,255,.14);display:inline-block;width:100%}
pre.sql .fresh{background:rgba(240,98,192,.22);display:inline-block;width:100%;animation:flash 1.2s}
@keyframes flash{0%{background:rgba(240,98,192,.6)}}
.caret{display:inline-block;width:8px;height:1.1em;background:#9B7BFF;vertical-align:-2px;animation:blink .7s infinite}
details.more{margin-top:16px}
details.more summary{cursor:pointer;font-weight:600}
details.more ul{margin:10px 0 0;padding-inline-start:22px}

/* ---------- data mart ---------- */
.mart-grid{display:grid;grid-template-columns:minmax(0,1.35fr) 80px minmax(0,1fr);gap:14px;align-items:stretch;margin-top:20px}
@media (max-width:860px){.mart-grid{grid-template-columns:1fr}}
.box-title{font:800 1.3rem "Alexandria",sans-serif}
.dw-box{border:1px solid var(--blue);box-shadow:0 0 0 4px var(--tint-blue),0 24px 60px -30px var(--blue)}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}
.chip{display:inline-flex;flex-direction:column;padding:7px 13px;border-radius:12px;border:1px solid var(--line);background:var(--panel);font-size:.92rem;line-height:1.35;transition:opacity .35s,border-color .35s,background-color .35s,transform .35s,box-shadow .35s}
.chip.fact{font-weight:600;border-color:var(--muted)}
.chip.dim{border-style:dashed}
.chip code{font-size:.72rem;color:var(--muted);direction:ltr;text-align:right;font-family:ui-monospace,"SFMono-Regular",Menlo,Consolas,monospace;font-weight:400}
.dw-box.filtering .chip{opacity:.25;transform:scale(.96)}
.dw-box.filtering .chip.on{opacity:1;transform:translateY(-3px);border-color:var(--mint);background:var(--tint-mint);box-shadow:0 8px 20px -10px var(--mint)}
.chip.flying{background:var(--tint-mint);border-color:var(--mint);box-shadow:0 0 24px -4px var(--mint)}
.chip.land{animation:land .5s cubic-bezier(.3,1.6,.5,1)}
@keyframes land{from{transform:scale(1.25)}}
.legend{display:flex;gap:6px 16px;flex-wrap:wrap;font-size:.84rem;color:var(--muted);margin-top:16px}
.legend .k{display:inline-block;width:22px;height:14px;border:1.5px solid var(--muted);border-radius:4px;vertical-align:middle;margin-inline-end:6px}
.legend .k.dash{border-style:dashed}
.mart-arrow{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;color:var(--mint);font-weight:600;font-size:.8rem;text-align:center;line-height:1.4}
.mart-arrow .a{font-size:2.4rem;line-height:1;text-shadow:0 0 18px var(--mint);animation:nudge 1.1s ease-in-out infinite}
.mart-arrow .a::before{content:"←"}
@keyframes nudge{50%{transform:translateX(-10px)}}
@media (max-width:860px){.mart-arrow .a::before{content:"↓"}@keyframes nudge{50%{transform:translateY(8px)}}}
.dm-box{border:1.5px dashed var(--mint)}
.dm-box.filled{border-style:solid;background:var(--tint-mint);box-shadow:0 0 0 4px var(--tint-mint),0 24px 60px -30px var(--mint)}
.dm-box .empty{margin-top:12px}
.meter{height:8px;background:var(--panel);border:1px solid var(--line);border-radius:4px;overflow:hidden;margin:8px 0 2px}
.meter span{display:block;height:100%;width:0;background:var(--mint);box-shadow:0 0 10px var(--mint);transition:width .9s cubic-bezier(.3,1.2,.4,1)}
dl.facts{display:grid;grid-template-columns:auto 1fr;gap:4px 12px;margin:14px 0 0}
dl.facts dt{color:var(--muted)}
dl.facts dd{margin:0;font-weight:600}
.shared-note{margin-top:12px}
.after-mart{margin-top:22px}
.after-mart p{max-width:72ch;margin-top:8px}

/* ---------- mining ---------- */
.key{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:24px}
.key > div{border-radius:20px;padding:16px 18px;border:1px solid var(--line);border-inline-start:4px solid var(--kc);background:var(--kt)}
.key strong{font-family:"Alexandria",sans-serif;font-size:1.08rem}
@media (max-width:700px){.key{grid-template-columns:1fr}}
.seg{margin-bottom:20px}
.mine-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:20px;align-items:start}
@media (max-width:920px){.mine-grid{grid-template-columns:1fr}}
.mine-grid h3{font-size:1.22rem;font-weight:700;margin-bottom:4px}
.receipts{position:relative;display:grid;grid-template-columns:repeat(auto-fill,minmax(128px,1fr));gap:9px;margin-top:14px}
.receipt{background:var(--panel);border:1px solid var(--line);border-top:3px dotted var(--muted);border-radius:6px;padding:6px 8px 8px;font-size:.84rem;line-height:1.5;rotate:var(--tilt,0deg);transition:opacity .3s,background-color .3s,border-color .3s,transform .3s,box-shadow .3s}
.receipt .no{font-size:.72rem;color:var(--muted)}
.receipts.fallin .receipt{animation:recFall .9s cubic-bezier(.2,1.3,.4,1) backwards;animation-delay:calc(var(--i)*50ms)}
@keyframes recFall{from{transform:translateY(-120px) rotate(var(--rot,20deg));opacity:0}}
.receipt.scan{outline:2px solid var(--pink);outline-offset:1px;transform:scale(1.06);box-shadow:0 0 20px -4px var(--pink)}
.receipts.focus .receipt{opacity:.25}
.receipts.focus .receipt.hit{opacity:1;border-color:var(--pink);background:var(--tint-pink);transform:scale(1.04);box-shadow:0 10px 24px -12px var(--pink)}
.beam{position:absolute;left:-6px;right:-6px;top:0;height:3px;border-radius:2px;background:linear-gradient(90deg,transparent,var(--pink),transparent);box-shadow:0 0 22px var(--pink);opacity:0;pointer-events:none;z-index:2}
.it{display:inline-block;margin:2px 0 0 4px;padding:0 6px;border-radius:6px;background:var(--bg);white-space:nowrap}
.it.hl{background:var(--pink);color:var(--on-acc)}
.mine-controls{display:flex;flex-wrap:wrap;gap:10px 12px;align-items:center;margin-bottom:12px}
.status{font-size:.92rem;color:var(--muted);min-height:1.6em}
.slider{display:flex;gap:10px;align-items:center;flex-wrap:wrap;padding:10px 0;border-block:1px solid var(--line)}
.slider input{accent-color:var(--sun);width:170px}
.rules{display:flex;flex-direction:column;gap:8px;margin-top:12px}
.rule{display:block;width:100%;text-align:start;padding:11px 13px;border:1px solid var(--line);border-radius:16px;background:var(--panel);cursor:pointer;animation:ruleIn .65s cubic-bezier(.2,1.4,.4,1) backwards;animation-delay:calc(var(--i)*70ms);transition:border-color .25s,background-color .25s,transform .25s,box-shadow .25s}
.rule:hover{border-color:var(--pink);transform:translateY(-1px)}
.rule[aria-pressed="true"]{border-color:var(--pink);background:var(--tint-pink);box-shadow:0 0 0 1px var(--pink),0 12px 28px -14px var(--pink)}
@keyframes ruleIn{from{opacity:0;transform:scale(.7) translateY(-10px)}}
.rule-text{display:block}
.rule-text b{font-weight:700}
.rule-text .arr{color:var(--pink);font-weight:800;margin:0 4px}
.rule-meter{display:block;height:6px;background:var(--line);border-radius:3px;margin:8px 0 6px;overflow:hidden}
.rule-meter span{display:block;height:100%;background:linear-gradient(90deg,var(--pink),var(--sun));border-radius:3px}
.rule-nums{display:flex;flex-wrap:wrap;gap:2px 16px;font-size:.82rem;color:var(--muted)}
.rule-nums strong{color:var(--ink);font-variant-numeric:tabular-nums}
.insight{margin-top:12px;padding:12px 14px;border-radius:14px;background:var(--tint-pink);border:1px solid var(--pink)}
.gloss{font-size:.88rem;color:var(--muted);margin:14px 0 0;padding:0;list-style:none}
.gloss li{margin:3px 0}
.gloss strong{color:var(--ink)}
#scatter svg{width:100%;height:auto;display:block;margin-top:8px}
.axis line{stroke:var(--line);stroke-width:1}
.axis text{fill:var(--muted);font-size:12px;font-family:"Rubik",Tahoma,sans-serif}
.axis .ax-title{fill:var(--ink);font-size:13px;font-weight:600}
.pt{fill:var(--muted);opacity:.85;transition:fill .5s}
.pt.drop{animation:ptDrop 1s cubic-bezier(.3,1.4,.5,1) backwards;animation-delay:var(--d)}
@keyframes ptDrop{from{transform:translateY(-340px);opacity:0}}
.cent{transition:transform .75s cubic-bezier(.3,.8,.2,1),opacity .3s}
.cent path{fill:var(--panel);stroke:var(--cc);stroke-width:3.5;animation:spin 2.4s linear infinite;transform-box:fill-box;transform-origin:center;filter:drop-shadow(0 0 6px var(--cc))}
.clusters{display:flex;flex-direction:column;gap:8px;margin-top:12px}
.cl{display:grid;grid-template-columns:16px 1fr;gap:10px;align-items:start;padding:11px 13px;border:1px solid var(--line);border-radius:16px;background:var(--panel);animation:ruleIn .65s cubic-bezier(.2,1.4,.4,1) backwards;animation-delay:calc(var(--i)*120ms)}
.cl .sw{width:14px;height:14px;border-radius:50%;margin-top:6px}
.cl-note{margin-top:6px}

/* ---------- compare ---------- */
.flips{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;margin-bottom:30px}
.flip{perspective:1100px;background:none;border:none;padding:0;height:236px;cursor:pointer;text-align:start}
.flip-in{position:relative;display:block;width:100%;height:100%;transition:transform .85s cubic-bezier(.3,1.25,.4,1);transform-style:preserve-3d}
.flip[aria-pressed="true"] .flip-in{transform:rotateY(180deg)}
.flip:hover .flip-in{transform:translateY(-4px)}
.flip[aria-pressed="true"]:hover .flip-in{transform:rotateY(180deg) translateY(-4px)}
.fface{position:absolute;inset:0;backface-visibility:hidden;-webkit-backface-visibility:hidden;border-radius:22px;border:1px solid var(--line);padding:18px;display:flex;flex-direction:column;justify-content:space-between}
.front{background:linear-gradient(160deg,var(--ft) 0%,var(--panel) 80%);border-top:3px solid var(--fc);box-shadow:0 20px 44px -24px var(--fc)}
.front .em{font-size:2.6rem;line-height:1;display:inline-block;filter:drop-shadow(0 0 14px var(--fc));animation:bob 3.5s ease-in-out infinite}
.front b{font:800 1.4rem "Alexandria",sans-serif;display:block;direction:ltr;text-align:right}
.front .tag{font-weight:500;color:var(--muted)}
.front .hint{font-size:.78rem;color:var(--muted)}
.back{background:var(--panel);color:var(--ink);transform:rotateY(180deg);border-color:var(--fc);box-shadow:0 0 0 1px var(--fc),0 20px 44px -24px var(--fc)}
.back b{font:700 1.05rem "Alexandria",sans-serif}
.back .kind{display:inline-block;font-size:.76rem;font-weight:700;padding:2px 10px;border-radius:999px;background:var(--fc);color:var(--on-acc);align-self:flex-start}
.cmp{margin-top:18px}
.cmp.show tbody tr{animation:rowIn .55s cubic-bezier(.3,1.3,.5,1) backwards}
.cmp.show tbody tr:nth-child(2){animation-delay:.06s}.cmp.show tbody tr:nth-child(3){animation-delay:.12s}.cmp.show tbody tr:nth-child(4){animation-delay:.18s}.cmp.show tbody tr:nth-child(5){animation-delay:.24s}.cmp.show tbody tr:nth-child(6){animation-delay:.3s}.cmp.show tbody tr:nth-child(7){animation-delay:.36s}
@keyframes rowIn{from{opacity:0;transform:translateX(-40px)}}
.cmp-key{margin-bottom:14px;max-width:72ch}
.tbl-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:20px;background:var(--glass);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px)}
table{width:100%;border-collapse:collapse;min-width:580px}
th,td{padding:12px 14px;text-align:start;vertical-align:top;border-bottom:1px solid var(--line)}
thead th{font:700 1rem "Alexandria",sans-serif;border-bottom:2px solid var(--c,var(--line))}
tbody th{font-weight:500;color:var(--muted);white-space:nowrap}
tbody tr:last-child td,tbody tr:last-child th{border-bottom:none}
.quiz{margin-top:40px}
.quiz-head{display:flex;align-items:center;gap:16px;flex-wrap:wrap}
.quiz-head h3{font-size:1.75rem;font-weight:800}
.ring{width:64px;height:64px;position:relative;flex:none}
.ring svg{width:64px;height:64px;transform:rotate(-90deg)}
.ring circle{fill:none;stroke-width:6}
.ring .bgc{stroke:var(--line)}
.ring .fg{stroke:var(--sun);stroke-linecap:round;stroke-dasharray:163.4;stroke-dashoffset:163.4;filter:drop-shadow(0 0 6px var(--sun));transition:stroke-dashoffset .8s cubic-bezier(.3,1.2,.4,1)}
.ring span{position:absolute;inset:0;display:grid;place-items:center;font:700 .95rem "Alexandria",sans-serif;direction:ltr}
.q{background:var(--glass);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border:1px solid var(--line);border-radius:20px;padding:15px 17px;margin-top:12px}
.q > p{margin-bottom:10px}
.opts{display:flex;flex-wrap:wrap;gap:8px}
.opt{padding:8px 16px;border-radius:999px;border:1px solid var(--line);background:var(--panel);cursor:pointer;font-weight:600;transition:transform .2s cubic-bezier(.3,1.5,.5,1),border-color .2s,box-shadow .2s}
.opt:hover:not(:disabled){border-color:var(--sun);transform:translateY(-2px);box-shadow:0 8px 20px -10px var(--sun)}
.opt:disabled{cursor:default}
.opt.right{border-color:var(--good);background:var(--tint-good);animation:yay .6s cubic-bezier(.3,1.7,.5,1)}
.opt.wrong{border-color:var(--bad);background:var(--tint-bad);animation:shake .5s}
.opt.still,.fb.still{animation:none}
@keyframes yay{40%{transform:scale(1.14)}}
@keyframes shake{20%{transform:translateX(-8px)}40%{transform:translateX(8px)}60%{transform:translateX(-5px)}80%{transform:translateX(5px)}}
.fb{margin-top:10px;font-size:.93rem;animation:fadeUp .4s backwards}
.fb.ok b{color:var(--good)}
.fb.no b{color:var(--bad)}
#quizReset{margin-top:18px}
#confetti{position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:100}
.foot{margin-top:56px;padding-top:16px;border-top:1px solid var(--line);font-size:.85rem;color:var(--muted)}

@media (max-width:600px){.hlbl{font-size:13px}.hlbl span{font-size:11px}.fall{opacity:.35}}
@media (max-width:520px){
  body{font-size:16px}
  main{padding:6px 14px 40px}
  .glass{padding:16px;border-radius:20px}
}
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation:none!important;transition:none!important}
}
