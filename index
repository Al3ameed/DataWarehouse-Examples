sizeCV();window.addEventListener('resize',sizeCV);
const CCOL=['#9B7BFF','#F062C0','#3FE0D0','#7D96FF','#FF9F5A','#EEEAFB'];
function burst(x,y,n){
  if(RM||!CX) return;
  for(let i=0;i<(n||70);i++) parts.push({x,y,vx:(Math.random()-.5)*13,vy:-Math.random()*13-4,r:Math.random()*6.28,vr:(Math.random()-.5)*.4,w:6+Math.random()*7,h:4+Math.random()*5,c:CCOL[i%CCOL.length],life:0});
