      <div class="tbl-wrap"><table>
        <thead><tr><th></th><th style="--c:var(--sun)">🌍 Drill Down</th><th style="--c:var(--pink)">⛏️ Data Mining</th></tr></thead>
        <tbody>
          <tr><th>بيعمل إيه</th><td>بينزل من رقم ملخّص لتفاصيله، خطوة خطوة</td><td>بيكتشف أنماط وعلاقات مستخبية في الداتا</td></tr>
          <tr><th>مين بيسأل</th><td>إنت، وبتختار تنزل فين</td><td>الخوارزمية، وبتدوّر لوحدها</td></tr>
          <tr><th>نوعه</th><td>عملية من عمليات OLAP</td><td>تقنيات من الإحصاء وتعلّم الآلة</td></tr>
          <tr><th>الناتج</th><td>نفس الأرقام بتفاصيل أكتر</td><td>معلومة جديدة: قاعدة، أو مجموعات، أو توقّع</td></tr>
          <tr><th>بيجاوب على</th><td>إيه اللي حصل؟ وفين؟ وإمتى؟</td><td>ليه حصل؟ وإيه اللي ممكن يحصل؟</td></tr>
          <tr><th>مثال</th><td>مصر ← الصعيد ← أسيوط ← ديروط</td><td>اللي بيشتري مكرونة غالبًا بيشتري صلصة</td></tr>
          <tr><th>محتاج خبرة</th><td>قليلة، أي مدير يقدر من لوحة تحكم</td><td>أكبر، لازم حد يفهم الخوارزميات ويقيّم النتايج</td></tr>
        </tbody>
      </table></div>
    </div>
    <div class="cmp" id="cmp-dw-mart" hidden>
