function ctick(){
  CX.clearRect(0,0,innerWidth,innerHeight);
  parts.forEach(p=>{p.vy+=.38;p.vx*=.985;p.x+=p.vx;p.y+=p.vy;p.r+=p.vr;p.life++;
    CX.save();CX.translate(p.x,p.y);CX.rotate(p.r);CX.fillStyle=p.c;CX.globalAlpha=Math.max(0,1-p.life/200);CX.fillRect(-p.w/2,-p.h/2,p.w,p.h);CX.restore();});
