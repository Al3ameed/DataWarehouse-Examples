const norm=p=>[(p.v-1)/19,(p.s-50)/750],denorm=c=>({v:c[0]*19+1,s:c[1]*750+50});
const SV={W:600,H:370,l:62,r:16,t:16,b:54};
const xs=v=>SV.l+(v/21)*(SV.W-SV.l-SV.r),ys=s=>SV.H-SV.b-(s/850)*(SV.H-SV.t-SV.b);
(function(){
  let g='';
  [0,5,10,15,20].forEach(v=>{g+='<line x1="'+xs(v)+'" x2="'+xs(v)+'" y1="'+SV.t+'" y2="'+(SV.H-SV.b)+'"/><text x="'+xs(v)+'" y="'+(SV.H-SV.b+18)+'" text-anchor="middle">'+v+'</text>';});
  [0,200,400,600,800].forEach(s=>{g+='<line x1="'+SV.l+'" x2="'+(SV.W-SV.r)+'" y1="'+ys(s)+'" y2="'+ys(s)+'"/><text x="'+(SV.l-8)+'" y="'+(ys(s)+4)+'" text-anchor="end">'+s+'</text>';});
  g+='<text class="ax-title" x="'+((SV.l+SV.W-SV.r)/2)+'" y="'+(SV.H-12)+'" text-anchor="middle">عدد الزيارات في الشهر</text>';
  g+='<text class="ax-title" transform="translate(16 '+((SV.t+SV.H-SV.b)/2)+') rotate(-90)" text-anchor="middle">متوسط الفاتورة (جنيه)</text>';
  const pts=CUST.map((p,i)=>'<circle class="pt" cx="'+xs(p.v)+'" cy="'+ys(p.s)+'" r="6.5" style="--d:'+(i*28)+'ms"/>').join('');
  const cents=[0,1,2].map(j=>'<g class="cent" style="opacity:0;--cc:'+CCOLS[j]+'"><path d="M0 -12 L12 0 L0 12 L-12 0 Z"/></g>').join('');
  $('#scatter').innerHTML='<svg viewBox="0 0 '+SV.W+' '+SV.H+'" role="img" aria-label="رسم نقاط للزباين حسب عدد الزيارات ومتوسط الفاتورة"><g class="axis">'+g+'</g>'+pts+cents+'</svg>';
})();
function dropPoints(){$$('#scatter .pt').forEach(c=>{c.classList.remove('drop');c.getBoundingClientRect();c.classList.add('drop');});}
function placeCents(cents,instant){
  $$('#scatter .cent').forEach((el,j)=>{
    const p=denorm(cents[j]);
    if(instant) el.style.transition='none';
    el.style.transform='translate('+xs(p.v)+'px,'+ys(p.s)+'px)';
    if(instant){el.getBoundingClientRect();el.style.transition='';}
    el.style.opacity='1';
  });
}
const assign=cents=>CUST.map(p=>{const q=norm(p);let best=0,bd=Infinity;cents.forEach((c,j)=>{const d=(q[0]-c[0])**2+(q[1]-c[1])**2;if(d<bd){bd=d;best=j;}});return best;});
const update=(cents,asg)=>cents.map((c,j)=>{const pts=CUST.filter((_,i)=>asg[i]===j).map(norm);if(!pts.length) return c;return [sum(pts.map(p=>p[0]))/pts.length,sum(pts.map(p=>p[1]))/pts.length];});
const colorPts=asg=>$$('#scatter .pt').forEach((el,i)=>{el.style.fill=asg?CCOLS[asg[i]]:'';});
const KM_IDLE='كل نقطة زبون، ومحدش قال للخوارزمية إن فيه مجموعات. دوس «شغّل K-Means» وهي هتقسّمهم 3 مجموعات لوحدها.';
let kmTok=0;
const avg=a=>a.length?sum(a)/a.length:0;
function showClusters(asg){
  const info=[0,1,2].map(j=>{const m=CUST.filter((_,i)=>asg[i]===j);return {j,n:m.length,v:avg(m.map(x=>x.v)),s:avg(m.map(x=>x.s))};});
  const daily=[...info].sort((a,b)=>b.v-a.v)[0],big=info.filter(x=>x!==daily).sort((a,b)=>b.s-a.s)[0],mid=info.find(x=>x!==daily&&x!==big);
  daily.name='☕ زبون يومي بفاتورة صغيرة';daily.act='يناسبه برنامج نقاط على المشتريات اليومية.';
  big.name='🛒 زيارات قليلة بفاتورة كبيرة';big.act='تناسبه عروض الكميات والتوصيل المجاني.';
  mid.name='🗓️ زبون أسبوعي بفاتورة متوسطة';mid.act='ممكن كوبون خصم يشجّعه يزور أكتر.';
  $('#clusters').innerHTML=[daily,mid,big].map((x,i)=>'<div class="cl" style="--i:'+i+'"><span class="sw" style="background:'+CCOLS[x.j]+'"></span><div><strong>'+x.name+'</strong><div class="small muted">'+x.n+' زبون، متوسط '+x.v.toFixed(1)+' زيارة في الشهر، وفاتورة حوالي '+Math.round(x.s)+' جنيه</div><div class="small">'+x.act+'</div></div></div>').join('')
    +'<p class="small muted cl-note">الخوارزمية ماكانتش تعرف الأسماء دي. هي لقت المجموعات بس، وإحنا اللي سمّيناها بعد ما شفنا أرقام كل مجموعة.</p>';
}
async function runKM(){
  const tok=++kmTok,btn=$('#kmRun');btn.disabled=true;
  $('#clusters').innerHTML='';colorPts(null);
  let cents=KM_INIT.map(i=>norm(CUST[i]));placeCents(cents,true);
  $('#kmStatus').textContent='حطّينا 3 مراكز (المعيّنات اللي بتلف) في أماكن عشوائية.';
  await sleep(1100);if(tok!==kmTok) return;
  let it=0,asg;
  while(it<12){
    it++;asg=assign(cents);colorPts(asg);
    $('#kmStatus').textContent='الدورة '+it+': كل زبون اتضمّ لأقرب مركز ليه.';
    await sleep(1000);if(tok!==kmTok) return;
    const nc=update(cents,asg),moved=Math.max(...nc.map((c,j)=>Math.hypot(c[0]-cents[j][0],c[1]-cents[j][1])));
    cents=nc;if(moved<1e-6) break;
    placeCents(cents);$('#kmStatus').textContent='الدورة '+it+': كل مركز اتنقل لنُص مجموعته.';
    await sleep(1000);if(tok!==kmTok) return;
  }
  $('#kmStatus').textContent='المراكز وقفت تتحرك بعد '+roundsText(it)+'، والخوارزمية لقت 3 أنواع زباين لوحدها 🎉';
  showClusters(asg);burstAt(btn,50);
  btn.disabled=false;btn.textContent='✨ شغّلها تاني';
}
function resetKM(){
  kmTok++;colorPts(null);$$('#scatter .cent').forEach(el=>{el.style.opacity='0';});
  $('#clusters').innerHTML='';$('#kmStatus').textContent=KM_IDLE;
  const b=$('#kmRun');b.disabled=false;b.textContent='✨ شغّل K-Means';
}
$('#kmRun').addEventListener('click',runKM);$('#kmReset').addEventListener('click',resetKM);
let mineTab='basket';
$$('#mineSeg .pill').forEach(p=>p.addEventListener('click',()=>{
  mineTab=p.dataset.m;
  $$('#mineSeg .pill').forEach(q=>q.setAttribute('aria-pressed',String(q===p)));
  $('#m-basket').hidden=mineTab!=='basket';$('#m-cluster').hidden=mineTab!=='cluster';
  if(mineTab==='cluster') dropPoints(); else renderReceipts(true);
}));
function onEnterMining(){if(mineTab==='basket') renderReceipts(true); else dropPoints();}

/* ================= Compare + quiz ================= */
$$('.flip').forEach(f=>f.addEventListener('click',()=>f.setAttribute('aria-pressed',String(f.getAttribute('aria-pressed')!=='true'))));
$$('#cmpPills .pill').forEach(p=>p.addEventListener('click',()=>{
  $$('#cmpPills .pill').forEach(q=>q.setAttribute('aria-pressed',String(q===p)));
  $$('.cmp').forEach(c=>{const on=c.id==='cmp-'+p.dataset.cmp;c.hidden=!on;c.classList.remove('show');if(on){void c.offsetWidth;c.classList.add('show');}});
}));
const OPTS=[['dd','🌍 Drill Down'],['mart','📦 Data Mart'],['mine','⛏️ Data Mining']];
const QUIZ=[
  {q:'المدير شايف إن مبيعات مصر قلّت، وعايز يدخل يشوف أنهي إقليم، وبعدين أنهي محافظة، وبعدين أنهي فرع هو السبب.',a:'dd',why:'هو عارف سؤاله وبينزل من الملخّص للتفاصيل خطوة خطوة. ده Drill Down على بُعد المكان.'},
  {q:'قسم الـ HR عايز قاعدة بيانات صغيرة فيها الموظفين والحضور والمرتبات بس، من غير ما يتوه في داتا المبيعات.',a:'mart',why:'نسخة مركّزة من المستودع لقسم واحد، يعني Data Mart.'},
  {q:'السوبر ماركت عايز يعرف إيه المنتجات اللي الناس بتشتريها مع بعض عشان يرتّب الرفوف، ومش عارف يبدأ منين.',a:'mine',why:'محدش عارف الإجابة مسبقًا، والخوارزمية هي اللي هتكتشف العلاقات. ده Data Mining (Association Rules).'},
  {q:'البنك عايز يتوقّع مين من العملاء ممكن يقفل حسابه الشهر الجاي.',a:'mine',why:'التوقّع من داتا قديمة شغل Data Mining، ونوعه اسمه Classification أو Prediction.'},
  {q:'محلل شايف مبيعات السنة كلها، وعايز يشوفها بالربع، وبعدين بالشهر.',a:'dd',why:'نزول من السنة للربع للشهر، يعني Drill Down على بُعد الزمن.'},
  {q:'فريق التسويق عايز نسخة من المستودع فيها الحملات والعملاء والقنوات بس، عشان تقاريره تطلع أسرع.',a:'mart',why:'جزء متخصص من المستودع لفريق واحد عشان السرعة والتركيز، يعني Data Mart.'}
];
let answers={},lastAns=-1;
function renderQuiz(){
  $('#quiz').innerHTML=QUIZ.map((x,i)=>{
    const ans=answers[i],done=ans!==undefined,fresh=i===lastAns;
    return '<div class="q"><p><strong>'+(i+1)+'.</strong> '+x.q+'</p><div class="opts">'+OPTS.map(([k,l])=>{
      let c='opt';if(done){if(k===x.a) c+=' right';else if(k===ans) c+=' wrong';if(!fresh) c+=' still';}
      return '<button class="'+c+'" data-q="'+i+'" data-k="'+k+'"'+(done?' disabled':'')+'>'+l+'</button>';}).join('')+'</div>'
      +(done?'<p class="fb '+(ans===x.a?'ok':'no')+(fresh?'':' still')+'"><b>'+(ans===x.a?'صح 🔥':'لأ مش دي 😬')+'</b> '+x.why+'</p>':'')+'</div>';
  }).join('');
  const n=Object.keys(answers).length,right=QUIZ.filter((x,i)=>answers[i]===x.a).length;
  $('#score').textContent=n?'جاوبت صح على '+right+' من '+n:'';
  $('#ringTxt').textContent=right+'/'+QUIZ.length;
  $('#ringFg').style.strokeDashoffset=String(163.4*(1-right/QUIZ.length));
}
$('#quiz').addEventListener('click',e=>{
  const b=e.target.closest('.opt');if(!b||b.disabled) return;
  const i=+b.dataset.q;answers[i]=b.dataset.k;lastAns=i;
  const ok=answers[i]===QUIZ[i].a;
  const r=b.getBoundingClientRect();
  renderQuiz();
  if(ok){burst(r.left+r.width/2,r.top+r.height/2,70);if(Object.keys(answers).length===QUIZ.length&&QUIZ.every((x,j)=>answers[j]===x.a)) setTimeout(()=>burst(innerWidth/2,innerHeight/3,180),300);}
});
$('#quizReset').addEventListener('click',()=>{answers={};lastAns=-1;renderQuiz();});

/* ================= Init ================= */
renderNode('dw',false);
initMap();
renderPanel();
typeSQL();
renderMart(false);
renderReceipts(false);
renderRules();
$('#kmStatus').textContent=KM_IDLE;
$('#mineStatus').textContent='الخوارزمية لسه ماقرتش ولا فاتورة.';
renderQuiz();
showView(location.hash.slice(1));
if(document.fonts&&document.fonts.ready) document.fonts.ready.then(moveInd);
})();
</script>
