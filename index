      <button class="flip rise" aria-pressed="false" style="--fc:var(--mint);--ft:var(--tint-mint);--rr:5deg"><span class="flip-in"><span class="fface front"><span class="em">📦</span><span><b>Data Mart</b><span class="tag">أوضة لكل قسم</span></span><span class="hint">دوس عشان تقلب ↻</span></span><span class="fface back"><span class="kind">تخزين</span><b>حتّة صغيرة من المستودع</b><span>متفصّلة لقسم واحد أو موضوع واحد، فبتبقى أسرع وأبسط.</span></span></span></button>
      <button class="flip rise" aria-pressed="false" style="--fc:var(--sun);--ft:var(--tint-sun);--rr:-4deg"><span class="flip-in"><span class="fface front"><span class="em">🌍</span><span><b>Drill Down</b><span class="tag">زووم للتفاصيل</span></span><span class="hint">دوس عشان تقلب ↻</span></span><span class="fface back"><span class="kind">استخدام</span><b>عملية من عمليات OLAP</b><span>من رقم ملخّص لتفاصيله خطوة خطوة. إنت اللي بتسأل وبتختار تنزل فين.</span></span></span></button>
      <button class="flip rise" aria-pressed="false" style="--fc:var(--pink);--ft:var(--tint-pink);--rr:7deg"><span class="flip-in"><span class="fface front"><span class="em">⛏️</span><span><b>Data Mining</b><span class="tag">كشف الأسرار</span></span><span class="hint">دوس عشان تقلب ↻</span></span><span class="fface back"><span class="kind">استخدام</span><b>خوارزميات بتكتشف</b><span>بتلاقي أنماط مستخبية وبتتوقّع اللي جاي. الخوارزمية هي اللي بتسأل.</span></span></span></button>
    </div>
    <div class="pills rise" id="cmpPills" style="--c:var(--sun)">
