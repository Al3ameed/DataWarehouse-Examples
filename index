      <span class="pipe" style="--c:var(--mint)" aria-hidden="true"></span>
      <div class="stack">
        <button class="node rise" data-node="olap" style="--c:var(--sun);--t:var(--tint-sun);--rr:8deg"><span class="ic">🌍</span><span><span class="node-title">Drill Down</span><br><span class="node-sub">زووم من الملخّص للتفاصيل</span></span></button>
