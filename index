      <span class="pipe" style="--c:var(--muted)" aria-hidden="true"></span>
      <button class="node rise" data-node="etl" style="--c:var(--violet);--t:var(--tint-blue);--rr:-7deg"><span class="ic">🧹</span><span class="node-title">ETL</span><span class="node-sub">سحب وتنضيف وتوحيد</span></button>
