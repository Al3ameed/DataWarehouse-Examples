      </div>
      <aside class="glass dpanel rise" style="--rr:-3deg" aria-live="polite">
        <span class="lvl-tag" id="pLevel"></span>
        <h3 id="pTitle"></h3>
        <div class="big"><span id="pBig">0</span><small>جنيه في 2025</small></div>
